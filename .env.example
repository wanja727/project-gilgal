# ─── 길갈 Supabase (Postgres, 서울) — 값은 .env.local 에만 ─────────────────
# 런타임: Supavisor 트랜잭션 모드 (:6543)
DATABASE_URL=""
# drizzle-kit migrate / 스크립트: Session pooler(:5432)
# (Direct 연결 db.*.supabase.co 는 IPv6 전용이라 대부분의 로컬 환경에서 접속되지 않는다)
DIRECT_URL=""

# ─── Auth.js ─────────────────────────────────────────────────────────────
# 길갈 전용 새 값: npx auth secret 또는 openssl rand -base64 32
AUTH_SECRET=""
# Selah 와 같은 카카오 앱의 REST API 키 / Client Secret
# (Selah 와 같은 이름 KAKAO_CLIENT_ID / KAKAO_CLIENT_SECRET 도 인식한다)
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# ─── 길갈 ────────────────────────────────────────────────────────────────
# 로컬·Preview 는 테스트 캠페인으로 기록해 실제 데이터와 구분한다
GILGAL_CAMPAIGN="joshua-2026-test"
# mock | db  (본문을 bible_verse 에 적재한 뒤 db — pnpm bible:load)
BIBLE_PROVIDER="mock"
# 개발 전용 현재 시각 오버라이드 (VERCEL_ENV=production 에서는 무시)
# 예: 2026-11-08T10:00:00+09:00
GILGAL_DEV_NOW=""
